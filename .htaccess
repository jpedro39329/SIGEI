# ============================================================
# SIGEI - Proteção de Segurança, Rotas e Cabeçalhos HTTP
# Caminho relativo: funciona tanto em / (hospedagem) quanto em /SIGEI/ (XAMPP)
# ============================================================

# Impede listagem pública de diretórios
Options -Indexes

# Cabeçalhos de Segurança HTTP
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # AUD-EXT-03: HSTS (apenas respostas HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # AUD-EXT-02: Redirecionamento permanente HTTP -> HTTPS (apenas em produção com domínio sigei.whf.bz)
    # Suporta conexao direta HTTPS ou proxy reverso (X-Forwarded-Proto)
    RewriteCond %{HTTP_HOST} ^(www\.)?sigei\.whf\.bz$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # Bloqueia acesso direto a pastas internas sensíveis e documentação/relatórios
    RewriteRule ^(config|banco|includes|relatorios-seguranca)(/|$) - [F,L,NC]

    # Bloqueia acesso a arquivos ocultos, dumps SQL e documentação Markdown
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(sql|md|log|bak|ini|sh)$ - [F,L,NC]

    # Intercepta qualquer acesso à pasta uploads/ e exige autenticação/autorização via PHP
    RewriteRule ^uploads/(contratos|documentos|fotos|laudos)/([^/]+)$ controllers/arquivo.php?pasta=$1&arquivo=$2 [QSA,L,NC]
    RewriteRule ^uploads(/|$) - [F,L,NC]

    # Rota amigável de 404 para caminhos inexistentes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

# ============================================================
# Compressão Gzip / Deflate e Brotli (conforme suporte da hospedagem)
# ============================================================
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ============================================================
# Cache de Navegador para Arquivos Estáticos (Versionados via ?v=filemtime)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
